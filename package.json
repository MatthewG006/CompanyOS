{
  "name": "sky-mountain-company-os",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "docker compose down -v && docker compose up -d postgres && node scripts/migrate.mjs && node scripts/seed.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "agents:worker": "node scripts/agent-worker.mjs",
    "format": "biome check --write .",
    "db:doctor": "node scripts/db-doctor.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "@biomejs/biome": "2.5.15"
  }
}
