# CompanyOS local environment — copy to .env.local and fill in what you use.
#   cp .env.example .env.local        (bash)
#   Copy-Item .env.example .env.local (PowerShell)
# .env.local is gitignored. Never commit real secrets.
# Production uses production/.env.production instead (see production/DEPLOYMENT.md).

# --- Core -------------------------------------------------------------------
# Local default when unset: postgres://companyos:companyos_dev_password@localhost:5432/companyos
# (matches docker-compose.yml). Set explicitly for any non-local database.
# SSL is verified by default; append sslmode=no-verify only for self-signed endpoints.
DATABASE_URL=
# Public origin of this app; used for OAuth callbacks. Defaults to http://localhost:3000.
APP_URL=http://localhost:3000

# --- Owner security -----------------------------------------------------------
# Encryption key for secrets stored in PostgreSQL. Must be 64 hex characters:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COMPANYOS_ENCRYPTION_KEY=
# Admin token guarding owner-only API actions and the worker endpoint.
COMPANYOS_ADMIN_TOKEN=
# Shared secret for signed event ingestion (POST /api/events/ingest).
COMPANYOS_INGEST_TOKEN=

# --- Agent worker -------------------------------------------------------------
# Worker transport: leave unset (or "http") to poll the app over HTTP.
# "db" claims runs directly from PostgreSQL — opt-in only; DATABASE_URL alone
# never selects it, and DB mode skips the HTTP route's ancillary jobs.
COMPANYOS_WORKER_MODE=
# Poll interval for the agent worker in milliseconds.
COMPANYOS_AGENT_WORKER_INTERVAL_MS=3000
# Hours before an unanswered manual handoff (ChatGPT/Claude paste-back) expires.
AGENT_HANDOFF_EXPIRY_HOURS=48
# Max local (Codex CLI / Ollama) runs started per hour. 0 means no limit.
AGENT_LOCAL_MAX_RUNS_PER_HOUR=30

# --- AI providers (all optional) ----------------------------------------------
# Billable API providers; each needs both its key and its model to activate.
OPENAI_API_KEY=
AI_OPENAI_MODEL=
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=
# Let automatically routed runs use billable API providers without a manual step.
AI_AUTO_ALLOW_BILLABLE=
# Local Ollama server. OLLAMA_BASE_URL defaults to http://localhost:11434.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Codex CLI: path to the codex executable and its home directory.
# Both default to the standard install locations when unset.
CODEX_CLI_PATH=
CODEX_HOME=
# Postal address used by owner-approved outreach actions; leave unset to disable them.
COMPANYOS_POSTAL_ADDRESS=

# --- Google (Gmail + Calendar) --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_QUERY=newer_than:30d
GOOGLE_GMAIL_PAGE_SIZE=100
GOOGLE_GMAIL_MAX_PAGES=5
GOOGLE_CALENDAR_DAYS_PAST=7
GOOGLE_CALENDAR_DAYS_FUTURE=45
GOOGLE_CALENDAR_PAGE_SIZE=250
GOOGLE_CALENDAR_MAX_PAGES=10

# --- GitHub collector -----------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- Proxmox VE collector ---------------------------------------------------------
PVE_API_URL=
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=

# --- Nextcloud collector ----------------------------------------------------------
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=

# --- WordPress publishing ---------------------------------------------------------
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASS=

# --- Production only --------------------------------------------------------------
# Used by the production Compose stack and scripts/check-production-env.mjs;
# not needed for local development.
POSTGRES_PASSWORD=
