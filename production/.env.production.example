# Copy to production/.env.production on the Proxmox host. Keep it out of Git.
# Generate random values with:
#   node -e "const c=require('node:crypto'); console.log(c.randomBytes(32).toString('base64url'))"
# Encryption key must be 64 hexadecimal characters:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# Use a strong random base64url string. It is also the password embedded below.
POSTGRES_PASSWORD=REPLACE_WITH_43_CHAR_RANDOM_BASE64URL
DATABASE_URL=postgres://companyos:REPLACE_WITH_43_CHAR_RANDOM_BASE64URL@postgres:5432/companyos

# Public HTTPS origin used for OAuth callbacks. Keep it behind Cloudflare Access
# and Tunnel; do not publish the app container port directly.
APP_URL=https://companyos.skymountaincloud.com
COMPANYOS_HTTP_PORT=3000
BACKUP_RETENTION_DAYS=14
CODEX_CLI_VERSION=0.143.0

COMPANYOS_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_KEY
COMPANYOS_ADMIN_TOKEN=REPLACE_WITH_43_CHAR_RANDOM_BASE64URL
COMPANYOS_INGEST_TOKEN=REPLACE_WITH_43_CHAR_RANDOM_BASE64URL

# Optional integrations; fill only when configuring each integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
PVE_API_URL=
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=

GOOGLE_GMAIL_QUERY=newer_than:30d
GOOGLE_GMAIL_PAGE_SIZE=100
GOOGLE_GMAIL_MAX_PAGES=5
GOOGLE_CALENDAR_DAYS_PAST=7
GOOGLE_CALENDAR_DAYS_FUTURE=45
GOOGLE_CALENDAR_PAGE_SIZE=250
GOOGLE_CALENDAR_MAX_PAGES=10

# Optional, potentially billable API providers. ChatGPT Free / Claude Free use
# owner-mediated handoff and do not need API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_OPENAI_MODEL=
AI_ANTHROPIC_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
COMPANYOS_AGENT_WORKER_INTERVAL_MS=3000
